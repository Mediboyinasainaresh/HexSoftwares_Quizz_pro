<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnOption"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_button_secondary_neo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvPrefix"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_option_prefix"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Option text"
        android:textColor="@color/quiz_text"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>