<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow is gone when pressed to give "pressed down" feel -->
            <item>
                <shape>
                    <corners android:radius="100dp" />
                    <solid android:color="@color/quiz_primary" />
                    <stroke android:width="3dp" android:color="#1A1B41" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Shadow -->
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <corners android:radius="100dp" />
                    <solid android:color="#1A1B41" />
                </shape>
            </item>
            <!-- Main Button -->
            <item android:right="4dp" android:bottom="4dp">
                <shape>
                    <corners android:radius="100dp" />
                    <solid android:color="@color/quiz_primary" />
                    <stroke android:width="3dp" android:color="#1A1B41" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>